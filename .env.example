# Copy this file to `.env` and fill in the keys you have.
# The package loads `.env` from the repo root automatically (no python-dotenv needed).
# Real environment variables always win over .env values.

# ── Required: the LLM for classification, query generation, and norm-card extraction ──
OPENAI_API_KEY=sk-...

# ── Optional: alternate LLM provider (litellm routes by model name) ──
# ANTHROPIC_API_KEY=sk-ant-...

# Model used for the LLM stages (default: gpt-5-mini). Norm-card generation uses
# gpt-5-mini for per-paper extraction and gpt-5 for the reduce/recipe steps.
# NORM_CARDS_MODEL=gpt-5-mini

# ── OpenAlex (primary paper source; keyless works) ──
# A contact email joins the polite pool (recommended, not a key):
OPENALEX_MAILTO=you@example.com
# A key raises your daily budget. NOTE: the topic-classification endpoint
# (text/topics, used during claim classification) is METERED (~$0.01/call, small
# free daily tier that resets midnight UTC). Add prepaid credit for batch runs:
# https://openalex.org/pricing
# OPENALEX_API_KEY=...

# ── Optional: extra full-text / search sources ──
# Semantic Scholar — keyless works (rate-limited); a free key raises limits.
# Used both as a search source and to resolve open-access PDFs by DOI.
# SEMANTIC_SCHOLAR_API_KEY=...
# Google Scholar via SerpAPI (paid) — only needed for the `google_scholar` source.
# SERP_API_KEY=...

# ── Optional tuning ──
# NORM_CARDS_HTTP_TIMEOUT=30
